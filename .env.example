# Local environment for docker compose. `make secrets` copies this file to .env and fills every
# empty value with a random secret; it never overwrites an existing .env.

# Host ports, if 3000 or 8000 is taken by something else.
WEB_PORT=3000
API_PORT=8000

# PostgreSQL superuser, used only by the image to initialise the cluster.
POSTGRES_PASSWORD=
# Schema owner: runs migrations only (OPS-07).
MA_OWNER_PASSWORD=
# API role, without BYPASSRLS.
MA_APP_PASSWORD=
# Cleanup worker role.
MA_WORKER_PASSWORD=

MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
# MinIO user of the API, limited to the two buckets (infra/minio/api-policy.json).
S3_ACCESS_KEY=ma-api
S3_SECRET_KEY=
