# Local environment for docker compose. `make secrets` copies this file to .env and fills every
# empty value with a random secret; in an existing .env it only appends keys that are missing.

# Host ports, if 3000 or 8000 is taken by something else.
WEB_PORT=3000
API_PORT=8000
# First three octets of the compose network (/24); the web proxy gets .10. A second stack
# running at the same time needs a different value, e.g. 10.157.1.
NET_PREFIX=10.157.0

# PostgreSQL superuser, used only by the image to initialise the cluster.
POSTGRES_PASSWORD=
# Schema owner: runs migrations only (OPS-07).
MA_OWNER_PASSWORD=
# API role, without BYPASSRLS.
MA_APP_PASSWORD=
# Cleanup worker role.
MA_WORKER_PASSWORD=

MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
# MinIO user of the API, limited to the two buckets (infra/minio/api-policy.json).
S3_ACCESS_KEY=ma-api
S3_SECRET_KEY=

# API secrets, at least 32 characters each. CSRF tokens are an HMAC of the session id with it.
CSRF_SECRET=
# Encrypts list cursors (page_token). Rotation: move the old value to PAGE_TOKEN_KEY_PREVIOUS.
PAGE_TOKEN_KEY=
